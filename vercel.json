{
  "version": 2,
  "cleanUrls": false,
  "builds": [
    { "src": "backend/server.js", "use": "@vercel/node" },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/server.js" },
    { "src": "/__/auth/(.*)", "dest": "https://clovas-shop.firebaseapp.com/__/auth/$1" },
    { "src": "/index.html", "status": 301, "headers": { "Location": "/" } },
    { "src": "/auth.html", "status": 301, "headers": { "Location": "/auth" } },
    { "src": "/shop.html", "status": 301, "headers": { "Location": "/shop" } },
    { "src": "/cart.html", "status": 301, "headers": { "Location": "/cart" } },
    { "src": "/checkout.html", "status": 301, "headers": { "Location": "/checkout" } },
    { "src": "/dashboard.html", "status": 301, "headers": { "Location": "/dashboard" } },
    { "src": "/admin/index.html", "status": 301, "headers": { "Location": "/admin/" } },
    { "src": "/admin/shoppers.html", "status": 301, "headers": { "Location": "/admin/shoppers" } },
    { "src": "/admin/shopper-detail.html", "status": 301, "headers": { "Location": "/admin/shopper-detail" } },
    { "src": "/admin/settings.html", "status": 301, "headers": { "Location": "/admin/settings" } },
    { "src": "/Home", "dest": "frontend/index.html" },
    { "src": "/css/(.*)", "dest": "frontend/css/$1" },
    { "src": "/js/(.*)", "dest": "frontend/js/$1" },
    { "src": "/admin$", "status": 308, "headers": { "Location": "/admin/" } },
    { "src": "/admin/([^./]+)", "dest": "frontend/admin/$1.html" },
    { "src": "/admin/(.*)", "dest": "frontend/admin/$1" },
    { "src": "/([^./]+)", "dest": "frontend/$1.html" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}
